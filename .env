# Local demo database. SQLite file lives alongside the Prisma schema.
# TODO(production): replace with a Canadian-region managed database connection
# string, supplied via a real secrets manager — never committed to git.
DATABASE_URL="file:./dev.db"

# ---- Key management (crypto-shredding) --------------------------------------
# KEY_VAULT: auto | kms | local
#   auto / kms = envelope encryption (KmsKeyVault). Per-item keys are wrapped
#                under a master key (KEK) that lives OUTSIDE the database; the DB
#                stores only ciphertext. This is the default.
#   local      = DEMO ONLY (LocalKeyVault): raw keys stored beside the data —
#                insecure, kept only to show the lifecycle without a KMS.
KEY_VAULT="auto"
# KMS_MASTER_KEY: base64-encoded 32-byte KEK for the local KMS. Leave BLANK and
# the app auto-provisions one at .citadel-secrets/kms-master.key (gitignored).
# Generate with: openssl rand -base64 32
KMS_MASTER_KEY=""
# TODO(production): the KEK comes from a Canadian-controlled managed KMS / HSM —
# never a file or env in the app. Swap LocalKmsClient for the managed KMS client.

# ---- Local AI (Ollama + Apertus) --------------------------------------------
# The app talks ONLY to a local Ollama server — no API keys, no cloud, ever.
#
# AI_PROVIDER: auto | apertus | heuristic
#   auto      = use local Apertus if Ollama+model are ready, else offline placeholder
#   apertus   = always use local Apertus (errors surface if Ollama is down)
#   heuristic = always use the offline rule-based placeholder (no Ollama needed)
AI_PROVIDER="auto"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="MichelRosselli/apertus:8b-instruct-2509-q4_k_m"
OLLAMA_EMBED_MODEL="nomic-embed-text"
# TODO(production): point OLLAMA_BASE_URL at the SAME Apertus model served on
# Canadian-controlled infrastructure (Canadian GPU host / on-prem), over a
# private, mutually-authenticated connection.

# ---- Accounts & sign-in (Auth.js / NextAuth v5) -----------------------------
# When ALL THREE of AUTH_SECRET, AUTH_GOOGLE_ID, AUTH_GOOGLE_SECRET are set, the
# app requires Google sign-in and scopes every item/audit/setting/key to the
# signed-in user (real multi-tenancy). When they are BLANK (the default below),
# the app runs in single-user DEMO mode with no login — this keeps the public
# prototype open. Generate a secret with: `openssl rand -base64 32`.
#   AUTH_SECRET="..."
#   AUTH_GOOGLE_ID="...apps.googleusercontent.com"
#   AUTH_GOOGLE_SECRET="..."
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Behind a reverse proxy, NextAuth must trust the forwarded host/proto and know
# its public origin. Leave AUTH_URL blank for local dev; set it in production.
AUTH_TRUST_HOST="true"
AUTH_URL=""
# TODO(production): AUTH_SECRET and the Google client secret come from a
# Canadian-controlled secrets manager; sign-in identity is the same Google/M365
# account used for mailbox OAuth.

# ---- Mailbox source ---------------------------------------------------------
# EMAIL_SOURCE: auto | sample | gmail
#   auto   = use a connected Gmail account if present, else synthetic demo data
#   sample = always synthetic demo data (the free-tier preview / offline demo)
#   gmail  = always Gmail (requires a connected account)
EMAIL_SOURCE="auto"

# ---- Gmail connector (Gmail API + OAuth 2.0, read-only) ---------------------
# Create an OAuth client in Google Cloud (Gmail API enabled, scope
# gmail.readonly, your address added as a Test user). Then put BOTH of these in
# .env.local (which is gitignored) — NEVER commit real credentials:
#   GOOGLE_CLIENT_ID="...apps.googleusercontent.com"
#   GOOGLE_CLIENT_SECRET="..."
GOOGLE_OAUTH_REDIRECT="http://localhost:3000/api/auth/google/callback"
# Public base URL of the app. Behind a reverse proxy (Caddy + HTTPS) set this to
# your real origin so post-OAuth redirects don't bounce to localhost, e.g.
#   APP_BASE_URL="https://citadel.aletheos.tech"
APP_BASE_URL=""
# How many recent messages to pull (free tier ultimately caps at 2 — Phase 6).
GMAIL_MAX_MESSAGES="10"
# TODO(production): per-user OAuth tokens in a Canadian-controlled secrets
# manager (never a file or the app DB — the prototype does so only because it is
# single-user and local); add a production redirect URI for your real domain.
