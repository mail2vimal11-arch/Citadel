# Local demo database. SQLite file lives alongside the Prisma schema.
# TODO(production): replace with a Canadian-region managed database connection
# string, supplied via a real secrets manager — never committed to git.
DATABASE_URL="file:./dev.db"

# ---- Local AI (Ollama + Apertus) --------------------------------------------
# The app talks ONLY to a local Ollama server — no API keys, no cloud, ever.
#
# AI_PROVIDER: auto | apertus | heuristic
#   auto      = use local Apertus if Ollama+model are ready, else offline placeholder
#   apertus   = always use local Apertus (errors surface if Ollama is down)
#   heuristic = always use the offline rule-based placeholder (no Ollama needed)
AI_PROVIDER="auto"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="MichelRosselli/apertus:8b-instruct-2509-q4_k_m"
OLLAMA_EMBED_MODEL="nomic-embed-text"
# TODO(production): point OLLAMA_BASE_URL at the SAME Apertus model served on
# Canadian-controlled infrastructure (Canadian GPU host / on-prem), over a
# private, mutually-authenticated connection.
