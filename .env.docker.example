# Copy this to `.env.docker` (gitignored) and fill in the blanks. docker-compose
# loads it at runtime. NOTE: docker env_file values are literal — do NOT quote.

# ---- Local AI (Ollama on the host) -----------------------------------------
AI_PROVIDER=auto
# The container reaches the host's Ollama via host.docker.internal (see compose).
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=MichelRosselli/apertus:8b-instruct-2509-q4_k_m
OLLAMA_EMBED_MODEL=nomic-embed-text

# ---- Accounts & sign-in (Auth.js / NextAuth v5) -----------------------------
# Set all three to require Google sign-in and enable real multi-tenancy. Leave
# blank to run the container in single-user DEMO mode (no login). Generate the
# secret with: openssl rand -base64 32
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_TRUST_HOST=true
AUTH_URL=https://citadel.aletheos.tech

# ---- Mailbox + Gmail OAuth --------------------------------------------------
EMAIL_SOURCE=auto
APP_BASE_URL=https://citadel.aletheos.tech
GOOGLE_OAUTH_REDIRECT=https://citadel.aletheos.tech/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_MAX_MESSAGES=10
