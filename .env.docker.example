# Copy this to `.env.docker` (gitignored) and fill in the blanks. docker-compose
# loads it at runtime. NOTE: docker env_file values are literal — do NOT quote.

# ---- Background forget scheduler (P3) ---------------------------------------
# Sweep cadence (ms) for forgetting expired items with no user interaction.
FORGET_SWEEP_INTERVAL_MS=60000
# Durable Postgres seam (off by default; compose `db` service uses the postgres
# profile). To use it: flip provider to "postgresql" in prisma/schema.prisma and
#   DATABASE_URL=postgresql://citadel:citadel@db:5432/citadel
# (DATABASE_URL is otherwise set in docker-compose.yml to the SQLite volume.)

# ---- Billing (Stripe — P12, opt-in; blank = demo mode, no charging) ---------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FULL_MONTHLY=
STRIPE_PRICE_FULL_ANNUAL=

# ---- Key management (crypto-shredding) --------------------------------------
# auto/kms = envelope encryption (keys apart from data); local = insecure demo.
KEY_VAULT=auto
# base64 32-byte master key (KEK). Leave blank to auto-provision a file under the
# mounted .citadel-secrets volume. Generate with: openssl rand -base64 32
KMS_MASTER_KEY=

# ---- Local AI (Ollama on the host) -----------------------------------------
AI_PROVIDER=auto
# The container reaches the host's Ollama via host.docker.internal (see compose).
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=MichelRosselli/apertus:8b-instruct-2509-q4_k_m
OLLAMA_EMBED_MODEL=nomic-embed-text

# ---- Accounts & sign-in (Auth.js / NextAuth v5) -----------------------------
# Set all three to require Google sign-in and enable real multi-tenancy. Leave
# blank to run the container in single-user DEMO mode (no login). Generate the
# secret with: openssl rand -base64 32
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_TRUST_HOST=true
AUTH_URL=https://citadel.aletheos.tech

# ---- Mailbox: Gmail + Microsoft 365 OAuth (both read-only) ------------------
EMAIL_SOURCE=auto
APP_BASE_URL=https://citadel.aletheos.tech
GOOGLE_OAUTH_REDIRECT=https://citadel.aletheos.tech/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_MAX_MESSAGES=10
MICROSOFT_OAUTH_REDIRECT=https://citadel.aletheos.tech/api/auth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_MAX_MESSAGES=10
