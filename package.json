    "react": "18.3.1",
    "react-dom": "18.3.1",
    "stripe": "^17.7.0"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "prisma": "5.22.0",
    "typescript": "5.5.3",
    "vitest": "^2.1.9"
  }
