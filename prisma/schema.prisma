// Citadel (your sovereign inbox) — demo data model (local SQLite).
//
// IMPORTANT: This database stores ONLY AI-derived data (summaries, triage
// labels, draft replies, lightweight metadata) — never raw mailbox content.
// All derived content is encrypted at rest with a per-item key (see lib/crypto.ts
// and lib/keyvault). "Forgetting" an item destroys its key, making the stored
// ciphertext permanently unrecoverable ("crypto-shredding").
//
// TODO(production): move to a Canadian-region managed Postgres (or equivalent)
// with encryption-at-rest, access logging, and backups governed by a data
// residency agreement.

generator client {
  provider = "prisma-client-js"
}

// Storage seam. SQLite is the local/CI/offline-demo default. The data model is
// provider-agnostic (no SQLite-specific column types or SQL), so going durable is
// a two-line switch with no schema rewrite:
//   1. provider = "postgresql"
//   2. DATABASE_URL = a Canadian-region managed Postgres connection string
// then `prisma db push`. See ARCHITECTURE.md ("Durable storage") and the opt-in
// migration smoke test (src/lib/db.postgres.test.ts). TODO(production): run on a
// Canadian-region managed Postgres with encryption-at-rest, access logging, and
// residency-governed backups.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A single AI-derived record for one source email.
// The sensitive fields (sender, subject, summary, draft, etc.) live ONLY inside
// the encrypted `ciphertext` blob — never in their own clear columns.
//
// `userId` scopes every item to its owner (multi-tenancy). It is a plain column
// (no FK to User) so the demo single-user fallback works without a User row.
model DerivedItem {
  id          String    @id @default(cuid())
  userId      String
  // Stable id of the originating email, used to avoid double-processing.
  // Unique PER USER (two users can hold the same synthetic sourceId).
  sourceId    String
  status      String    @default("ACTIVE") // ACTIVE | FORGOTTEN
  processedAt DateTime  @default(now())
  // When this item is scheduled to be forgotten. Null means "only on logout".
  forgetAt    DateTime?
  forgottenAt DateTime?

  // Encrypted derived payload (AES-256-GCM). Unreadable once the key is destroyed.
  ciphertext  String
  iv          String
  authTag     String

  // The per-item key lives in the KeyVault. Destroying it shreds this item.
  keyId       String

  @@unique([userId, sourceId])
  @@index([userId, status])
}

// Per-item key record. Each derived item gets its own key; "destroying" it nulls
// `material` and flips `destroyed`, which is what makes a forget irreversible.
//
// Under the default KmsKeyVault, `material` holds the WRAPPED data key (the key
// encrypted under the KMS master key) — i.e. ciphertext, never a usable key. The
// master key lives OUTSIDE this database, so the DB alone reveals nothing.
// Under the demo LocalKeyVault (KEY_VAULT=local) `material` holds a raw base64
// key beside the data — insecure, kept only to demonstrate the lifecycle.
// TODO(production): the KMS master key comes from a Canadian-controlled HSM/KMS;
// destruction is a hardware-backed, auditable operation.
model VaultKey {
  id          String    @id @default(cuid())
  material    String? // wrapped DEK (KMS) or raw base64 key (demo); null after destruction
  destroyed   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  destroyedAt DateTime?
}

// Append-only audit trail. Records THAT something happened and WHEN — never the
// forgotten content itself. Scoped per user.
model AuditEvent {
  id        String   @id @default(cuid())
  userId    String
  itemId    String?
  sourceRef String? // a non-sensitive reference label, safe to keep after forget
  event     String // PROCESSED | FORGOTTEN | SETTINGS_CHANGED
  message   String // human-readable, non-sensitive
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Per-user settings (the forget schedule). Keyed by userId.
model Setting {
  userId         String @id
  forgetInterval String @default("24h") // "1h" | "24h" | "7d" | "logout"
}

// --------------------------------------------------------------------------
// Auth.js (NextAuth) models — accounts, OAuth links, and sessions.
// Standard schema required by @auth/prisma-adapter (database sessions).
// --------------------------------------------------------------------------
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}
